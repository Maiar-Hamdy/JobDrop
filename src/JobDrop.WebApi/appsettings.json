{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=JobDrop;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "jobdrop",
    "Audience": "jobdrop-api",
    "SigningKey": "REPLACE_ME_WITH_32+_CHAR_SECRET_IN_USER_SECRETS_AAAAAA",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Geography": {
    "BaseUrl": "http://localhost:8090",
    "ApiKey": "REPLACE_ME",
    "TimeoutSeconds": 8
  },
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com",
    "ApiKey": "",
    "IntegrationId": "",
    "HmacSecret": "",
    "TimeoutSeconds": 30
  },
  "Redis": { "Configuration": "localhost:6379" },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] }
}